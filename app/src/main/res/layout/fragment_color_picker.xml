<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Colour"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a colour for your habit"
            android:textSize="15sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins">

            <View
                android:id="@+id/colorBlue"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#90CAF9"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorSky"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#81D4FA"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorPurple"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#CE93D8"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorLavender"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#B39DDB"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorPink"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#F48FB1"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorRed"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#EF9A9A"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorOrange"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#FFCC80"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorYellow"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#FFF59D"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorGreen"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#A5D6A7"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorMint"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#80CBC4"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorBrown"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#BCAAA4"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorGrey"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="#CFD8DC"
                android:clickable="true"
                android:focusable="true" />

        </GridLayout>

    </LinearLayout>

</ScrollView>